{
  "expo": {
    "name": "MemoTile",
    "slug": "memotile-app-anti",
    "version": "1.2.3",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF8F4"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": [
      "memotile",
      "com.googleusercontent.apps.459952418126-de8a2a1g87tr2o9hmtkgissdksto41m5"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36,
            "compileSdkVersion": 36,
            "ndkVersion": "27.1.12297006",
            "packagingOptions": {
              "useLegacyPackaging": false
            },
            "gradleProperties": {
              "android.use16KPageAlignment": "true",
              "android.suppressUnsupportedCompileSdk": "36"
            }
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-image-picker",
        {
          "photosPermission": "We need access to your photo gallery so you can select and upload photos to create your custom photo tiles.",
          "cameraPermission": "We need camera access to let you take new photos for your custom photo tiles."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "MemoTile scans your photo library on this device to automatically find the best photos of your child. Your photos are analyzed only on your device and are never uploaded.",
          "savePhotosPermission": "MemoTile needs permission to save photos to your library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-apple-authentication",
      "@react-native-firebase/crashlytics",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#FF7E66"
        }
      ]
    ],
    "ios": {
      "buildNumber": "35",
      "supportsTablet": true,
      "bundleIdentifier": "com.benjiwon.memotileappanti",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:memotile.com",
        "applinks:www.memotile.com"
      ],
      "locales": {
        "en": "./languages/en.json",
        "th": "./languages/th.json"
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "We need access to your photo gallery so you can select and upload photos to create your custom photo tiles.",
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "memotile",
              "com.googleusercontent.apps.459952418126-2sptgnl1nsc5t5chmdll4i0rrovfo4fm"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 17,
      "package": "com.memotile.android",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-foreground.png",
        "backgroundColor": "#FDF8F4"
      },
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#FDF8F4"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "memotile.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "www.memotile.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "998b0866-55ab-44aa-a1b1-9b82af8c3fe1"
      },
      "googleExpoClientId": "459952418126-4bnko4k5cu9k6gf3h7rhcl0hst82npdh.apps.googleusercontent.com",
      "googleIosClientId": "459952418126-2sptgnl1nsc5t5chmdll4i0rrovfo4fm.apps.googleusercontent.com",
      "googleAndroidClientId": "459952418126-tdgvbf25v41314h0gcpgik3shp1ul3jc.apps.googleusercontent.com",
      "googleWebClientId": "459952418126-4bnko4k5cu9k6gf3h7rhcl0hst82npdh.apps.googleusercontent.com"
    }
  }
}
